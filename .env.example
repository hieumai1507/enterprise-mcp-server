# ==============================================================================
# Enterprise PostgreSQL MCP Server - Environment Configuration
# ==============================================================================

ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# OAuth 2.1 & OpenID Connect Settings
# ------------------------------------------------------------------------------
# In production, point to Keycloak, Okta, or Auth0 issuer realm URL
OIDC_ISSUER=http://localhost:8080/realms/ai-services
OIDC_AUDIENCE=mcp-postgres-server
OIDC_JWKS_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# PostgreSQL Isolated Connection Pools (Strictly NO Token Passthrough)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_db

# Read-Only Service Account Pool (SELECT privileges only)
DB_USER_RO=mcp_ro_service
DB_PASSWORD_RO=ro_service_secret

# Read-Write Service Account Pool (Restricted DML)
DB_USER_RW=mcp_rw_service
DB_PASSWORD_RW=rw_service_secret

# Audit Logging Service Account Pool (Append-only mcp_audit table writer)
DB_USER_AUDIT=mcp_audit_writer
DB_PASSWORD_AUDIT=audit_service_secret

# Connection Pool Limits
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# AI Guardrail & Intent Classifier (TypeSafe AI JEV Model)
# ------------------------------------------------------------------------------
JEV_MODEL_ENDPOINT=https://api.typesafe.ai/v1/jev
JEV_API_KEY=mock-jev-api-key-for-development
JEV_RISK_THRESHOLD=0.70
JEV_ENABLED=true
